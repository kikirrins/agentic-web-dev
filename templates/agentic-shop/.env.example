# Copia este archivo a .env.local y llénalo. Nunca subas .env.local a git.
# Si todo queda vacío, la tienda usa mock.shop y los scripts de ops usan datos --mock.

# Dominio de la tienda, p. ej. mi-tienda-dev.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Storefront API (canal Headless > Storefront API > token privado). Solo del lado del servidor.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Admin API (app del Dev Dashboard instalada en la tienda). Solo la usan los scripts de ops/.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Contraseña del panel del dueño en /ops.
OPS_PASSWORD=
