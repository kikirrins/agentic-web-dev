{
  "name": "agentic-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3017",
    "build": "next build",
    "start": "next start --port 3017",
    "lint": "eslint",
    "ops:snapshot": "node --env-file-if-exists=.env.local ops/snapshot.mjs",
    "ops:analyze": "node --env-file-if-exists=.env.local ops/analyze.mjs",
    "ops:propose": "node --env-file-if-exists=.env.local ops/propose.mjs",
    "ops:apply": "node --env-file-if-exists=.env.local ops/apply.mjs",
    "ops:daily": "node --env-file-if-exists=.env.local ops/daily.mjs",
    "ops:seed": "node --env-file-if-exists=.env.local ops/seed-dev-store.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  }
}
